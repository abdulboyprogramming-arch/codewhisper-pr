# ============================================================
# CodeWhisper PR - Environment Configuration
# ============================================================

# --- APPLICATION ---
NODE_ENV=development
APP_NAME=CodeWhisper PR
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=info

# --- SECURITY ---
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- DATABASE ---
DATABASE_URL=postgresql+asyncpg://codewhisper:codewhisper123@localhost:5432/codewhisper
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- REDIS ---
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=3600
REDIS_SESSION_TTL=86400

# --- PARITOK ---
PARITOK_API_KEY=your-paritok-api-key-here
PARITOK_BASE_URL=https://api.paritok.io/v1
PARITOK_MODEL=paritok-4b-v1
PARITOK_HOSTED_GPU_URL=http://localhost:8080

# --- LLM ---
LLM_PROVIDER=openai
LLM_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4-turbo-preview
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.7
LLM_BASE_URL=https://api.openai.com/v1

# --- CELERY ---
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=['json']
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# --- MONITORING ---
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=8000
SENTRY_DSN=

# --- CORS ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1

# --- GIT ---
GIT_CLONE_DIRECTORY=/tmp/codewhisper-repos
GIT_MAX_FILE_SIZE=1048576

# --- TOKEN OPTIMIZATION ---
TOKEN_OPTIMIZATION_ENABLED=true
TOKEN_OPTIMIZATION_THRESHOLD=0.75
TOKEN_SAVINGS_TARGET=0.74
MAX_CONTEXT_TOKENS=4096
MIN_OPTIMIZATION_TOKENS=100

# --- FEATURES ---
ENABLE_ANALYTICS=true
ENABLE_CACHING=true
ENABLE_BACKGROUND_PROCESSING=true

# --- EMAIL ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@codewhisper-pr.io

# --- DEPLOYMENT ---
DEPLOYMENT_ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
WORKERS=4
