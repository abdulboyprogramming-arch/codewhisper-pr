{
  "name": "@codewhisper/frontend",
  "version": "1.0.0",
  "private": true,
  "description": "CodeWhisper PR - Token-efficient AI code review frontend",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
