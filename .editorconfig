# ============================================================
# CodeWhisper PR - EditorConfig
# ============================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 100

[*.{js,ts,tsx,jsx,mjs}]
indent_size = 2
max_line_length = 100

[*.{json,yaml,yml,html,css,scss}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = 0

[*.{sh,bash,zsh}]
indent_size = 4
max_line_length = 100

[Dockerfile]
indent_size = 4

[*.{tf,tfvars}]
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 4

[*.xml]
indent_size = 2

[*.{rst,txt}]
max_line_length = 80
